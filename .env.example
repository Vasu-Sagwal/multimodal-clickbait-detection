# Comma-separated API keys. Their order must match YOUTUBE_API_KEY_PROJECTS.
YOUTUBE_API_KEYS=key1,key2,key3,key4,key5
# Google Cloud project ID for each key, in the same order as the keys above.
# Keys may share a project; distinct projects have independent quota ledgers.
YOUTUBE_API_KEY_PROJECTS=project-id-1,project-id-2,project-id-3,project-id-4,project-id-5
